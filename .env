# 会议服务器地址
VITE_JITSI_SERVER=same-origin

# API 默认走同源统一前缀；开发环境由 Vite proxy 转发到 jitsi-meet-api
VITE_API_BASE_URL=
VITE_API_PREFIX=/mapi
VITE_API_PROXY_TARGET=http://localhost:9000

# prejoin 预加入界面（Jitsi 自带的"用户名输入 + 加入会议按钮"页面）
# true  = 启用 prejoin，由 Jitsi 自己收集昵称并点击加入
# false = 关闭 prejoin，直接进入会议；此时昵称由本系统在前端收集（创建/加入窗口、密码门）
VITE_PREJOIN_ENABLED=false

# 桌面客户端自定义协议；/invite 页面会用它尝试唤起 Electron 应用
VITE_DESKTOP_PROTOCOL=cloudmeet
